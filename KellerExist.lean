theorem exL3_1 (ξ u v w : ℝ) :
    V1ex ξ u v w
      = H1ex ξ u v w * (Lpoly u v w * ξ^3 + Bpoly v w * ξ - 2*w) := by
  simp only [V1ex, H1ex, Lpoly, Bpoly]; ring

/-- **Global existence, component 1.** -/
theorem exists_glob1 (ξ u v w b c : ℝ)
    (h2 : 2 * Kpoly u v w * b = G2side ξ u v w)
    (h3 : 8 * Kpoly u v w * c = G3side ξ u v w)
    (hC : Lpoly u v w * ξ^3 + Bpoly v w * ξ - 2*w = 0)
    (hK : Kpoly u v w ≠ 0) :
    F1 ξ b c = u := by
  have k1 := exL1_1 ξ u v w b c h3
  have k2 := exL2_1 ξ u v w b h2
  have k3 := exL3_1 ξ u v w
  rw [hC, mul_zero] at k3
  rw [k3] at k2
  have hW : W1ex ξ u v w b = 0 := by
    rcases mul_eq_zero.mp k2 with h | h
    · exact absurd h (pow_ne_zero 4 (mul_ne_zero two_ne_zero hK))
    · exact h
  rw [hW] at k1
  rcases mul_eq_zero.mp k1 with h | h
  · exact absurd h (mul_ne_zero (by norm_num) hK)
  · linarith [h]

theorem exL1_2 (ξ u v w b c : ℝ)
    (h3 : 8 * Kpoly u v w * c = G3side ξ u v w) :
