theorem exL3_2 (ξ u v w : ℝ) :
    V2ex ξ u v w
      = H2ex ξ u v w * (Lpoly u v w * ξ^3 + Bpoly v w * ξ - 2*w) := by
  simp only [V2ex, H2ex, Lpoly, Bpoly]; ring

/-- **Global existence, component 2.** -/
theorem exists_glob2 (ξ u v w b c : ℝ)
    (h2 : 2 * Kpoly u v w * b = G2side ξ u v w)
    (h3 : 8 * Kpoly u v w * c = G3side ξ u v w)
    (hC : Lpoly u v w * ξ^3 + Bpoly v w * ξ - 2*w = 0)
    (hK : Kpoly u v w ≠ 0) :
    F2 ξ b c = v := by
  have k1 := exL1_2 ξ u v w b c h3
  have k2 := exL2_2 ξ u v w b h2
  have k3 := exL3_2 ξ u v w
  rw [hC, mul_zero] at k3
  rw [k3] at k2
  have hW : W2ex ξ u v w b = 0 := by
    rcases mul_eq_zero.mp k2 with h | h
    · exact absurd h (pow_ne_zero 3 (mul_ne_zero two_ne_zero hK))
    · exact h
  rw [hW] at k1
  rcases mul_eq_zero.mp k1 with h | h
  · exact absurd h (mul_ne_zero (by norm_num) hK)
  · linarith [h]

theorem exL1_3 (ξ u v w b c : ℝ)
    (h3 : 8 * Kpoly u v w * c = G3side ξ u v w) :
    8 * Kpoly u v w * (F3 ξ b c - w) = W3ex ξ u v w b := by
  simp only [F3, Kpoly, G3side, W3ex] at h3 ⊢
  linear_combination (((-1 : ℝ)/1) * ξ^3) * h3

theorem exL2_3 (ξ u v w b : ℝ)
    (h2 : 2 * Kpoly u v w * b = G2side ξ u v w) :
    (2 * Kpoly u v w)^1 * W3ex ξ u v w b = V3ex ξ u v w := by
  simp only [Kpoly, G2side, W3ex, V3ex] at h2 ⊢
  linear_combination (((-648 : ℝ)/1) * ξ^2 * u * w^2 + ((216 : ℝ)/1) * ξ^2 * v * w + ((-192 : ℝ)/1) * ξ^2) * h2

theorem exL3_3 (ξ u v w : ℝ) :
    V3ex ξ u v w
      = H3ex ξ u v w * (Lpoly u v w * ξ^3 + Bpoly v w * ξ - 2*w) := by
  simp only [V3ex, H3ex, Lpoly, Bpoly]; ring

/-- **Global existence, component 3.** -/
theorem exists_glob3 (ξ u v w b c : ℝ)
    (h2 : 2 * Kpoly u v w * b = G2side ξ u v w)
    (h3 : 8 * Kpoly u v w * c = G3side ξ u v w)
    (hC : Lpoly u v w * ξ^3 + Bpoly v w * ξ - 2*w = 0)
    (hK : Kpoly u v w ≠ 0) :
    F3 ξ b c = w := by
  have k1 := exL1_3 ξ u v w b c h3
  have k2 := exL2_3 ξ u v w b h2
  have k3 := exL3_3 ξ u v w
  rw [hC, mul_zero] at k3
  rw [k3] at k2
  have hW : W3ex ξ u v w b = 0 := by
    rcases mul_eq_zero.mp k2 with h | h
    · exact absurd h (pow_ne_zero 1 (mul_ne_zero two_ne_zero hK))
    · exact h
  rw [hW] at k1
  rcases mul_eq_zero.mp k1 with h | h
  · exact absurd h (mul_ne_zero (by norm_num) hK)
  · linarith [h]

