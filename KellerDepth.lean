/-
  Depth layer (phase 3): the second story of the n₂ = 9 certificate.

  quad kit — four more generic quadratic sign lemmas.
  exists_glob1/2/3 — hypothesis-form global existence: at any point of ℝ³
    with K ≠ 0, every root ξ of the fiber cubic together with the
    shape-relation values b, c gives a genuine preimage (proved by
    linear_combination with explicit polynomial cofactors).
  story2_nine_1/2/3 — over each of the three first-story preimages of the
    n₂ = 9 point (isolated in tight rational intervals), the second-story
    fiber cubic has exactly three real roots, L < 0, and K ≠ 0 there.
    With fiber_nine and the global identities this is the last analytic
    step of n₂ = 9; what remains is bookkeeping composition.
-/
import KellerBridge

namespace KellerDepth
open KellerCerts KellerBridge

/-! ### Quadratic sign kit -/

lemma quad_pos_disc (al be ga : ℝ) (hal : 0 < al) (hd : be^2 - 4*al*ga < 0) :
    ∀ x : ℝ, 0 < al*x^2 + be*x + ga := by
  intro x
  by_contra hq
  rw [not_lt] at hq
  nlinarith [sq_nonneg (2*al*x + be), mul_nonneg hal.le (neg_nonneg.mpr hq)]

lemma quad_neg_disc (al be ga : ℝ) (hal : al < 0) (hd : be^2 - 4*al*ga < 0) :
    ∀ x : ℝ, al*x^2 + be*x + ga < 0 := by
  intro x
  by_contra hq
  rw [not_lt] at hq
  nlinarith [sq_nonneg (2*al*x + be), mul_nonneg (neg_nonneg.mpr hal.le) hq]

lemma quad_pos_convex_incr (al be ga a b : ℝ) (hal : 0 ≤ al)
    (hs : 0 ≤ 2*al*a + be) (ha : 0 < al*a^2 + be*a + ga) :
    ∀ x : ℝ, a < x → x < b → 0 < al*x^2 + be*x + ga := by
  intro x hax _
  nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ x - a)
      (by nlinarith : (0:ℝ) ≤ al*(x + a) + be)]

lemma quad_pos_convex_decr (al be ga a b : ℝ) (hal : 0 ≤ al)
    (hs : 2*al*b + be ≤ 0) (hb : 0 < al*b^2 + be*b + ga) :
    ∀ x : ℝ, a < x → x < b → 0 < al*x^2 + be*x + ga := by
  intro x _ hxb
  nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ b - x)
      (by nlinarith : (0:ℝ) ≤ -(al*(b + x) + be))]

