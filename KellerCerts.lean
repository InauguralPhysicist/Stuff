/-- **Certificate**: the fiber cubic at this point has exactly three real
roots, and Nf (hence the sibling L-value, since Df = 64K⁴ > 0) has the
published sign pattern (−, −, −) at them — so n₂ = 9 here. -/
theorem certificate_nine :
    ∃ r1 r2 r3 : ℝ, r1 < r2 ∧ r2 < r3 ∧
      CNine r1 = 0 ∧ CNine r2 = 0 ∧ CNine r3 = 0 ∧
      (∀ x : ℝ, CNine x = 0 → x = r1 ∨ x = r2 ∨ x = r3) ∧
      (NfNine r1 < 0) ∧ (NfNine r2 < 0) ∧ (NfNine r3 < 0) := by
  obtain ⟨r1, h1a, h1b, h1z⟩ := rootNine1
  obtain ⟨r2, h2a, h2b, h2z⟩ := rootNine2
  obtain ⟨r3, h3a, h3b, h3z⟩ := rootNine3
  have h12 : r1 < r2 := by
    have : (((-227 : ℝ)/8306) : ℝ) ≤ ((-147 : ℝ)/5395) := by norm_num
    linarith
  have h23 : r2 < r3 := by
    have : (((-154 : ℝ)/5669) : ℝ) ≤ ((21035 : ℝ)/385459) := by norm_num
    linarith
  refine ⟨r1, r2, r3, h12, h23, h1z, h2z, h3z, ?_, ?_, ?_, ?_⟩
  · intro x hx
    refine cubic_localize ((-3493989477513 : ℝ)/200000000) ((780557 : ℝ)/20000) ((71 : ℝ)/100)
        r1 r2 r3 (by norm_num) h12 h23 ?_ ?_ ?_ x ?_
    · unfold CNine at h1z; linarith
    · unfold CNine at h2z; linarith
    · unfold CNine at h3z; linarith
    · unfold CNine at hx; linarith
  · have hs := signRNine1 r1 h1a h1b
    have hd := divNine r1
    rw [hd, h1z]
    simpa using hs
  · have hs := signRNine2 r2 h2a h2b
    have hd := divNine r2
    rw [hd, h2z]
    simpa using hs
  · have hs := signRNine3 r3 h3a h3b
    have hd := divNine r3
    rw [hd, h3z]
    simpa using hs

