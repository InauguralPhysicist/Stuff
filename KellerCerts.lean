/-
  Machine-checkable certificates for Part IV of
  "The Alpöge Keller Map as a Quantum System: Verification and New Results".

  Bridge facts (verified in the report, quoted not re-proved): for y ∈ ℚ³ with
  L(y) < 0 and K(y) ≠ 0, the real F-preimages of y biject with the real roots
  of the fiber cubic C(x) = L(y)x³ + B(y)x − 2y₃, and the L-value at the
  preimage with x₁ = ξ equals Nf(ξ)/Df(y) with Df(y) = 64K(y)⁴ > 0.  The
  second-story multiplicity is n₂(y) = Σ_roots (3 if Nf(ξ) < 0 else 1).

  This file certifies, for the four rational points of report §IV.2: the fiber
  cubic has exactly three real roots, and Nf carries the published sign at
  every root — hence n₂ = 9, 3, 5, 7 respectively, and each on an open set by
  strictness.  All coefficients are explicit rationals.
-/
import Mathlib

namespace KellerCerts

/-- A depressed cubic (no x² term) with three distinct real roots has no
further real roots. -/
lemma cubic_localize (c3 c1 c0 r1 r2 r3 : ℝ) (hc3 : c3 ≠ 0)
    (h12 : r1 < r2) (h23 : r2 < r3)
    (e1 : c3*r1^3 + c1*r1 + c0 = 0) (e2 : c3*r2^3 + c1*r2 + c0 = 0)
    (e3 : c3*r3^3 + c1*r3 + c0 = 0) :
    ∀ x : ℝ, c3*x^3 + c1*x + c0 = 0 → x = r1 ∨ x = r2 ∨ x = r3 := by
  have h21 : r2 - r1 ≠ 0 := sub_ne_zero.mpr h12.ne'
  have h31 : r3 - r1 ≠ 0 := sub_ne_zero.mpr (by linarith : r1 < r3).ne'
  have h32 : r3 - r2 ≠ 0 := sub_ne_zero.mpr h23.ne'
  have kA : (r2 - r1) * (c3*(r1^2 + r1*r2 + r2^2) + c1) = 0 := by
    linear_combination e2 - e1
  have kB : (r3 - r1) * (c3*(r1^2 + r1*r3 + r3^2) + c1) = 0 := by
    linear_combination e3 - e1
  have hA : c3*(r1^2 + r1*r2 + r2^2) + c1 = 0 :=
    (mul_eq_zero.mp kA).resolve_left h21
  have hB : c3*(r1^2 + r1*r3 + r3^2) + c1 = 0 :=
    (mul_eq_zero.mp kB).resolve_left h31
  have kC : (r3 - r2) * (c3 * (r1 + r2 + r3)) = 0 := by
    linear_combination hB - hA
  have hsum : c3 * (r1 + r2 + r3) = 0 := (mul_eq_zero.mp kC).resolve_left h32
  have hr3 : r3 = -r1 - r2 := by
    rcases mul_eq_zero.mp hsum with h | h
    · exact absurd h hc3
    · linarith
  have hc1 : c1 = -(c3*(r1^2 + r1*r2 + r2^2)) := by linarith
  have hc0 : c0 = c3*(r1^2*r2 + r1*r2^2) := by
    linear_combination e1 - r1 * hA
  intro x hx
  have hfac : c3*(x - r1)*(x - r2)*(x - r3) = 0 := by
    rw [hr3]
    rw [hc1, hc0] at hx
    linear_combination hx
  have hprod : (x - r1)*(x - r2)*(x - r3) = 0 := by
    rcases mul_eq_zero.mp (by rw [show c3*(x - r1)*(x - r2)*(x - r3)
        = c3*((x - r1)*(x - r2)*(x - r3)) from by ring] at hfac; exact hfac) with h | h
    · exact absurd h hc3
    · exact h
  rcases mul_eq_zero.mp hprod with h | h
  · rcases mul_eq_zero.mp h with h' | h'
    · exact Or.inl (by linarith [sub_eq_zero.mp h'])
    · exact Or.inr (Or.inl (by linarith [sub_eq_zero.mp h']))
  · exact Or.inr (Or.inr (by linarith [sub_eq_zero.mp h]))

/-- IVT wrapper: continuous, positive at `a`, negative at `b` ⟹ root in `(a,b)`. -/
lemma root_of_sign_change {f : ℝ → ℝ} (hf : Continuous f) {a b : ℝ}
    (hab : a < b) (ha : 0 < f a) (hb : f b < 0) :
    ∃ x, a < x ∧ x < b ∧ f x = 0 := by
  have h0 : (0 : ℝ) ∈ Set.Ioo (f b) (f a) := ⟨hb, ha⟩
  obtain ⟨x, hx, hfx⟩ := intermediate_value_Ioo' hab.le hf.continuousOn h0
  exact ⟨x, hx.1, hx.2, hfx⟩

/-- Convex quadratic negative at both endpoints is negative between them. -/
lemma quad_neg_convex (al be ga a b : ℝ) (hal : 0 ≤ al) (hab : a < b)
    (hRa : al*a^2 + be*a + ga < 0) (hRb : al*b^2 + be*b + ga < 0) :
    ∀ x : ℝ, a < x → x < b → al*x^2 + be*x + ga < 0 := by
  intro x hax hxb
  nlinarith [mul_nonneg (mul_nonneg (mul_nonneg hal
      (by linarith : (0:ℝ) ≤ x - a)) (by linarith : (0:ℝ) ≤ b - x))
      (by linarith : (0:ℝ) ≤ b - a),
    mul_pos (by linarith : (0:ℝ) < b - x) (by linarith : (0:ℝ) < -(al*a^2 + be*a + ga)),
    mul_pos (by linarith : (0:ℝ) < x - a) (by linarith : (0:ℝ) < -(al*b^2 + be*b + ga))]

/-- Concave quadratic positive at both endpoints is positive between them. -/
lemma quad_pos_concave (al be ga a b : ℝ) (hal : al ≤ 0) (hab : a < b)
    (hRa : 0 < al*a^2 + be*a + ga) (hRb : 0 < al*b^2 + be*b + ga) :
    ∀ x : ℝ, a < x → x < b → 0 < al*x^2 + be*x + ga := by
  intro x hax hxb
  have h := quad_neg_convex (-al) (-be) (-ga) a b (by linarith) hab
    (by nlinarith) (by nlinarith) x hax hxb
  nlinarith [h]

/-- Concave quadratic, nondecreasing at `b`, negative at `b` ⟹ negative on `(a,b)`. -/
lemma quad_neg_incr (al be ga a b : ℝ) (hal : al < 0) (hslope : 0 ≤ 2*al*b + be)
    (hRb : al*b^2 + be*b + ga < 0) :
    ∀ x : ℝ, a < x → x < b → al*x^2 + be*x + ga < 0 := by
  intro x _ hxb
  nlinarith [mul_pos (by linarith : (0:ℝ) < b - x)
      (by nlinarith : (0:ℝ) < al*(b + x) + be)]

/-- Concave quadratic, nonincreasing at `a`, negative at `a` ⟹ negative on `(a,b)`. -/
lemma quad_neg_decr (al be ga a b : ℝ) (hal : al < 0) (hslope : 2*al*a + be ≤ 0)
    (hRa : al*a^2 + be*a + ga < 0) :
    ∀ x : ℝ, a < x → x < b → al*x^2 + be*x + ga < 0 := by
  intro x hax _
  nlinarith [mul_pos (by linarith : (0:ℝ) < x - a)
      (by nlinarith : (0:ℝ) < -(al*(a + x) + be))]


