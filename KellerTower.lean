/-- The sibling chart point is a genuine F-preimage of y*. -/
lemma z_lift (t : ℝ) (hC : CStar t = 0) (hgt : ((-1643 : ℝ)/50) < t) :
    F1 t (bzr t) (czr t) = yStar1 ∧ F2 t (bzr t) (czr t) = yStar2 ∧
    F3 t (bzr t) (czr t) = yStar3 := by
  have hqr := qr_zero t hC hgt
  have h2 : 2 * Kpoly yStar1 yStar2 yStar3 * bzr t = G2side t yStar1 yStar2 yStar3 := by
    have h := spec2_id t; rw [hqr, mul_zero, add_zero] at h; exact h
  have h3 : 8 * Kpoly yStar1 yStar2 yStar3 * czr t = G3side t yStar1 yStar2 yStar3 := by
    have h := spec3_id t; rw [hqr, mul_zero, add_zero] at h; exact h
  have hCu : Lpoly yStar1 yStar2 yStar3 * t^3 + Bpoly yStar2 yStar3 * t - 2*yStar3 = 0 := by
    rw [← cStarEval t]; exact hC
  exact ⟨exists_glob1 t yStar1 yStar2 yStar3 (bzr t) (czr t) h2 h3 hCu kStarNe,
         exists_glob2 t yStar1 yStar2 yStar3 (bzr t) (czr t) h2 h3 hCu kStarNe,
         exists_glob3 t yStar1 yStar2 yStar3 (bzr t) (czr t) h2 h3 hCu kStarNe⟩

/-- **The sibling engine**: over any CStar-root right of z*₁ there is an
F²-preimage of the sibling chart point — the +1 of the tower. -/
lemma sibling_lift (t : ℝ) (hC : CStar t = 0) (hgt : ((-1643 : ℝ)/50) < t) :
    ∃ va vb vc : ℝ,
      F1 (F1 va vb vc) (F2 va vb vc) (F3 va vb vc) = t ∧
      F2 (F1 va vb vc) (F2 va vb vc) (F3 va vb vc) = bzr t ∧
      F3 (F1 va vb vc) (F2 va vb vc) (F3 va vb vc) = czr t := by
  have hqr := qr_zero t hC hgt
  have hkz : Kpoly t (bzr t) (czr t) = Kzr t := by
    have h := kz_id t; rw [hqr, mul_zero, add_zero] at h; exact h
  have hlz : Lpoly t (bzr t) (czr t) = Lzr t := by
    have h := lz_id t; rw [hqr, mul_zero, add_zero] at h; exact h
  have hbz : Bpoly (bzr t) (czr t) = Bzr t := by
    have h := bz_id t; rw [hqr, mul_zero, add_zero] at h; exact h
  have hKne : Kpoly t (bzr t) (czr t) ≠ 0 := by
    rw [hkz]
    intro h0
    have hb := bez1K t
    rw [hqr, h0] at hb
    simp only [mul_zero, add_zero] at hb
    exact absurd hb (by norm_num)
  have hLne : Lpoly t (bzr t) (czr t) ≠ 0 := by
    rw [hlz]
    intro h0
    have hb := bez1L t
    rw [hqr, h0] at hb
    simp only [mul_zero, add_zero] at hb
    exact absurd hb (by norm_num)
  obtain ⟨x, hx⟩ := cubic_real_root (Lpoly t (bzr t) (czr t))
    (Bpoly (bzr t) (czr t)) (-(2 * czr t)) hLne
  have hxC : Lpoly t (bzr t) (czr t) * x^3 + Bpoly (bzr t) (czr t) * x
      - 2 * czr t = 0 := by linarith
  set bw : ℝ := G2side x t (bzr t) (czr t) / (2 * Kpoly t (bzr t) (czr t)) with hbwdef
  set cw : ℝ := G3side x t (bzr t) (czr t) / (8 * Kpoly t (bzr t) (czr t)) with hcwdef
  have h2K : (2:ℝ) * Kpoly t (bzr t) (czr t) ≠ 0 := mul_ne_zero two_ne_zero hKne
  have h8K : (8:ℝ) * Kpoly t (bzr t) (czr t) ≠ 0 := mul_ne_zero (by norm_num) hKne
  have hbw : 2 * Kpoly t (bzr t) (czr t) * bw = G2side x t (bzr t) (czr t) := by
    rw [hbwdef, mul_comm, div_mul_cancel₀ _ h2K]
  have hcw : 8 * Kpoly t (bzr t) (czr t) * cw = G3side x t (bzr t) (czr t) := by
    rw [hcwdef, mul_comm, div_mul_cancel₀ _ h8K]
  have hFw1 : F1 x bw cw = t := exists_glob1 x t (bzr t) (czr t) bw cw hbw hcw hxC hKne
  have hFw2 : F2 x bw cw = bzr t := exists_glob2 x t (bzr t) (czr t) bw cw hbw hcw hxC hKne
  have hFw3 : F3 x bw cw = czr t := exists_glob3 x t (bzr t) (czr t) bw cw hbw hcw hxC hKne
  have hCzr : Lzr t * x^3 + Bzr t * x - 2 * czr t = 0 := by
    rw [← hlz, ← hbz]; exact hxC
  have hNKval : 27*x*(G3side x t (bzr t) (czr t))^2 - 36*((G2side x t (bzr t) (czr t))*(G3side x t (bzr t) (czr t))) + 512*(Kpoly t (bzr t) (czr t))^2 = NKrr x t := by
    have h := nk_id x t; rw [hqr, mul_zero, add_zero] at h; exact h
  have hNKne : NKrr x t ≠ 0 := by
    intro h0
    have hb := bezK x t
    rw [hqr, hCzr, h0] at hb
    simp only [mul_zero, add_zero, zero_add] at hb
    exact absurd hb (by norm_num)
  have hKw : Kpoly x bw cw ≠ 0 := by
    intro h0
    have hcomb : 64 * (Kpoly t (bzr t) (czr t))^2 * Kpoly x bw cw = NKrr x t := by
      rw [polyClearK x bw cw (Kpoly t (bzr t) (czr t)), hbw, hcw]
      exact hNKval
    rw [h0, mul_zero] at hcomb
    exact hNKne hcomb.symm
  have hNLval : 27*x^2*(G3side x t (bzr t) (czr t))^2*(Kpoly t (bzr t) (czr t))^2 - 72*x*((G2side x t (bzr t) (czr t))*(G3side x t (bzr t) (czr t)))*(Kpoly t (bzr t) (czr t))^2
      + 1024*x*(Kpoly t (bzr t) (czr t))^4 + (G2side x t (bzr t) (czr t))^3*(G3side x t (bzr t) (czr t)) - 16*(G2side x t (bzr t) (czr t))^2*(Kpoly t (bzr t) (czr t))^2 = NLrr x t := by
    have h := nl_id x t; rw [hqr, mul_zero, add_zero] at h; exact h
  have hNLne : NLrr x t ≠ 0 := by
    intro h0
    have hb := bezL x t
    rw [hqr, hCzr, h0] at hb
    simp only [mul_zero, add_zero, zero_add] at hb
    exact absurd hb (by norm_num)
  have hLw : Lpoly x bw cw ≠ 0 := by
    intro h0
    have hcomb : 64 * (Kpoly t (bzr t) (czr t))^4 * Lpoly x bw cw = NLrr x t := by
      rw [polyClearL x bw cw (Kpoly t (bzr t) (czr t)), hbw, hcw]
      exact hNLval
    rw [h0, mul_zero] at hcomb
    exact hNLne hcomb.symm
  obtain ⟨x2, hx2⟩ := cubic_real_root (Lpoly x bw cw) (Bpoly bw cw) (-(2 * cw)) hLw
  have hx2C : Lpoly x bw cw * x2^3 + Bpoly bw cw * x2 - 2 * cw = 0 := by linarith
  set bv : ℝ := G2side x2 x bw cw / (2 * Kpoly x bw cw) with hbvdef
  set cv : ℝ := G3side x2 x bw cw / (8 * Kpoly x bw cw) with hcvdef
  have hbv : 2 * Kpoly x bw cw * bv = G2side x2 x bw cw := by
    rw [hbvdef, mul_comm, div_mul_cancel₀ _ (mul_ne_zero two_ne_zero hKw)]
  have hcv : 8 * Kpoly x bw cw * cv = G3side x2 x bw cw := by
    rw [hcvdef, mul_comm, div_mul_cancel₀ _ (mul_ne_zero (by norm_num) hKw)]
  have hv1 : F1 x2 bv cv = x := exists_glob1 x2 x bw cw bv cv hbv hcv hx2C hKw
  have hv2 : F2 x2 bv cv = bw := exists_glob2 x2 x bw cw bv cv hbv hcv hx2C hKw
  have hv3 : F3 x2 bv cv = cw := exists_glob3 x2 x bw cw bv cv hbv hcv hx2C hKw
  exact ⟨x2, bv, cv,
    by rw [hv1, hv2, hv3]; exact hFw1,
    by rw [hv1, hv2, hv3]; exact hFw2,
    by rw [hv1, hv2, hv3]; exact hFw3⟩

/-- **n₃(y*) ≥ 11**: the nine comp_nine points plus one F²-preimage over
each certificate_star sibling — the exact3 headline, machine-checked. -/
theorem tower_eleven :
    ∃ S : Finset (ℝ × ℝ × ℝ), S.card = 11 ∧
      ∀ a b c : ℝ, (a, b, c) ∈ S →
        F1 (F1 (F1 a b c) (F2 a b c) (F3 a b c))
           (F2 (F1 a b c) (F2 a b c) (F3 a b c))
           (F3 (F1 a b c) (F2 a b c) (F3 a b c)) = yStar1 ∧
        F2 (F1 (F1 a b c) (F2 a b c) (F3 a b c))
           (F2 (F1 a b c) (F2 a b c) (F3 a b c))
           (F3 (F1 a b c) (F2 a b c) (F3 a b c)) = yStar2 ∧
        F3 (F1 (F1 a b c) (F2 a b c) (F3 a b c))
           (F2 (F1 a b c) (F2 a b c) (F3 a b c))
           (F3 (F1 a b c) (F2 a b c) (F3 a b c)) = yStar3 := by
  classical
  obtain ⟨S9, hcard9, hiff⟩ := comp_nine_count
  obtain ⟨s2, s3, h12, h23, hz2, hz3, _, _, _, _, _⟩ := certificate_star
  obtain ⟨va2, vb2, vc2, hA2, hB2, hC2⟩ := sibling_lift s2 hz2 h12
  have h13 : ((-1643 : ℝ)/50) < s3 := lt_trans h12 h23
  obtain ⟨va3, vb3, vc3, hA3, hB3, hC3⟩ := sibling_lift s3 hz3 h13
  have hne2 : ((va2, vb2, vc2) : ℝ × ℝ × ℝ) ∉ S9 := by
    intro hmem
    have h := ((hiff va2 vb2 vc2).mpr hmem).1
    rw [hA2] at h
    exact absurd h (ne_of_gt h12)
  have hne3 : ((va3, vb3, vc3) : ℝ × ℝ × ℝ) ∉ S9 := by
    intro hmem
    have h := ((hiff va3 vb3 vc3).mpr hmem).1
    rw [hA3] at h
    exact absurd h (ne_of_gt h13)
  have hne32 : ((va3, vb3, vc3) : ℝ × ℝ × ℝ) ≠ (va2, vb2, vc2) := by
    intro heq
    have e := congrArg (fun p : ℝ × ℝ × ℝ =>
      F1 (F1 p.1 p.2.1 p.2.2) (F2 p.1 p.2.1 p.2.2) (F3 p.1 p.2.1 p.2.2)) heq
    dsimp only at e
    rw [hA3, hA2] at e
    exact absurd e (ne_of_gt h23)
  have hv3notin : ((va3, vb3, vc3) : ℝ × ℝ × ℝ) ∉
      insert ((va2, vb2, vc2) : ℝ × ℝ × ℝ) S9 := by
    simp only [Finset.mem_insert]
    push_neg
    exact ⟨hne32, hne3⟩
  refine ⟨insert ((va3, vb3, vc3) : ℝ × ℝ × ℝ)
    (insert ((va2, vb2, vc2) : ℝ × ℝ × ℝ) S9), ?_, ?_⟩
  · rw [Finset.card_insert_of_notMem hv3notin,
      Finset.card_insert_of_notMem hne2, hcard9]
  · intro a b c hmem
    rcases Finset.mem_insert.mp hmem with h3eq | hmem2
    · simp only [Prod.mk.injEq] at h3eq
      obtain ⟨e1, e2, e3⟩ := h3eq
      rw [e1, e2, e3, hA3, hB3, hC3]
      exact z_lift s3 hz3 h13
    rcases Finset.mem_insert.mp hmem2 with h2eq | hmem9
    · simp only [Prod.mk.injEq] at h2eq
      obtain ⟨e1, e2, e3⟩ := h2eq
      rw [e1, e2, e3, hA2, hB2, hC2]
      exact z_lift s2 hz2 h12
    · obtain ⟨h1, h2, h3⟩ := (hiff a b c).mpr hmem9
      rw [h1, h2, h3]
      exact ⟨yStar_eq1, yStar_eq2, yStar_eq3⟩

end KellerTower
