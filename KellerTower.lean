/-- CStar factors through the sibling quadratic. -/
lemma factorStar : ∀ t : ℝ,
    CStar t = ((-319705014102625550400028849 : ℝ)/2500000000000000) * (t + (1643 : ℝ)/50) * QrP t := by
  intro t; simp only [CStar, QrP]; ring

/-- A CStar-root strictly right of z*₁ is a QrP-root. -/
lemma qr_zero (t : ℝ) (hC : CStar t = 0) (hgt : ((-1643 : ℝ)/50) < t) : QrP t = 0 := by
  have hf := factorStar t
  rw [hC] at hf
  have ht : t + (1643 : ℝ)/50 ≠ 0 := ne_of_gt (by linarith)
  rcases mul_eq_zero.mp hf.symm with h | h
  · rcases mul_eq_zero.mp h with h' | h'
    · exact absurd h' (by norm_num)
    · exact absurd h' ht
  · exact h

/-- The x₂ chart spec at y*, mod QrP. -/
lemma spec2_id : ∀ t : ℝ,
    2 * Kpoly yStar1 yStar2 yStar3 * bzr t
      = G2side t yStar1 yStar2 yStar3 + qspec2 * QrP t := by
  intro t
  simp only [Kpoly, yStar1, yStar2, yStar3, bzr, qspec2, QrP, G2side]
  ring

/-- The x₃ chart spec at y*, mod QrP. -/
lemma spec3_id : ∀ t : ℝ,
    8 * Kpoly yStar1 yStar2 yStar3 * czr t
      = G3side t yStar1 yStar2 yStar3 + qspec3 * QrP t := by
  intro t
  simp only [Kpoly, yStar1, yStar2, yStar3, czr, qspec3, QrP, G3side]
  ring

lemma kz_id : ∀ t : ℝ, Kpoly t (bzr t) (czr t) = Kzr t + qKz t * QrP t := by
  intro t; simp only [Kpoly, bzr, czr, Kzr, qKz, QrP]; ring

lemma lz_id : ∀ t : ℝ, Lpoly t (bzr t) (czr t) = Lzr t + qLz t * QrP t := by
  intro t; simp only [Lpoly, bzr, czr, Lzr, qLz, QrP]; ring

lemma bz_id : ∀ t : ℝ, Bpoly (bzr t) (czr t) = Bzr t + qBz * QrP t := by
  intro t; simp only [Bpoly, bzr, czr, Bzr, qBz, QrP]; ring

lemma bez1L : ∀ t : ℝ, ALz t * Lzr t + BLz * QrP t = 1 := by
  intro t; simp only [ALz, Lzr, BLz, QrP]; ring

lemma bez1K : ∀ t : ℝ, AKz t * Kzr t + BKz * QrP t = 1 := by
  intro t; simp only [AKz, Kzr, BKz, QrP]; ring

/-- Clearing the chart denominators of K, generically. -/
lemma polyClearK (x B C K : ℝ) :
    64 * K^2 * Kpoly x B C
      = 27*x*(8*K*C)^2 - 36*((2*K*B)*(8*K*C)) + 512*K^2 := by
  simp only [Kpoly]; ring

/-- Clearing the chart denominators of L, generically. -/
lemma polyClearL (x B C K : ℝ) :
    64 * K^4 * Lpoly x B C
      = 27*x^2*(8*K*C)^2*K^2 - 72*x*((2*K*B)*(8*K*C))*K^2 + 1024*x*K^4
        + (2*K*B)^3*(8*K*C) - 16*(2*K*B)^2*K^2 := by
  simp only [Lpoly]; ring

